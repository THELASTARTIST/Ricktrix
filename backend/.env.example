# Copy to backend/.env and fill in. Everything here is optional: with no
# values at all the server still runs and serves autofare.js directly.
#
# The API keys are on Supabase: Project Settings > API.
# The anon key is safe to ship to the browser. The service-role key is NOT --
# it bypasses row level security and must stay on the server.

# --- Supabase -------------------------------------------------------------
# Set both to read from the database instead of autofare.js.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Set this to persist route submissions and run the seeder.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Moderation -----------------------------------------------------------
# Comma-separated emails allowed to read /api/submissions.
# Leave empty and nobody is an admin -- deliberate, so a missing value can
# never open the moderation queue to the world.
ADMIN_EMAILS=you@example.com

# --- HTTP -----------------------------------------------------------------
# Extra origins allowed to call the API. Leave this unset or empty: the API and
# the site are served by the same process on the same origin, so no cross-origin
# request is ever made and there is nothing to allow.
#
# Set it to a comma-separated list of exact origins only if you later host the
# site somewhere else, e.g.
#   CORS_ORIGINS=https://your-domain.netlify.app
#
# Not `*`. Browsers reject `Access-Control-Allow-Origin: *` when the response
# also carries credentials, so it does not work for the authenticated endpoints
# it appears to permit.
# CORS_ORIGINS=
