# Keep the build context small and, more importantly, keep secrets out of it.
#
# backend/.env holds SUPABASE_SERVICE_ROLE_KEY, which bypasses row-level
# security entirely. Anything baked into an image is readable by anyone who can
# pull it, and images on public registries are public. It is listed here rather
# than relying on the .env being absent, because the usual case is that it is
# present -- that is the whole point of running the backend locally.

.git
.gitignore
**/__pycache__
**/*.pyc
**/.pytest_cache

# 800 MB of TensorFlow and a stale interpreter. The image installs its own.
backend/.venv
venv
.venv

# Secrets and local overrides.
backend/.env
backend/.env.*
!.env.example

# Rebuilt inside the image by scripts.build_site; copying a stale one in
# would ship yesterday's site.
backend/public

# The icons are generated by scripts/make_icons.py and committed, so the
# image build does not have to re-rasterise them. Remove this line if you
# would rather generate them during the build.
